{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graduation Project",
  "type": "object",
  "required": ["project_id", "student", "title", "problem_statement", "scope_level", "scope_constraints", "status", "approval", "similarity"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^PRJ-[0-9]{4}-[0-9]{3}$"},
    "student": {"type": "object", "required": ["id", "name", "folder_name"]},
    "title": {"type": "string", "minLength": 5},
    "problem_statement": {"type": "string", "minLength": 20},
    "scope_level": {"type": "string", "const": "Đồ án tốt nghiệp - MVP có thể demo và bảo vệ"},
    "scope_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "target_users": {"type": "array", "items": {"type": "string"}},
    "core_use_cases": {"type": "array", "items": {"type": "string"}},
    "main_entities": {"type": "array", "items": {"type": "string"}},
    "unique_contribution": {"type": "array", "items": {"type": "string"}},
    "requested_documents": {"type": "array", "items": {"type": "string"}},
    "preferred_stack": {"type": "object"},
    "status": {"enum": ["INTAKE", "OUTLINE_DRAFT", "WAITING_FOR_APPROVAL", "APPROVED", "IMPLEMENTING", "REVIEWING", "VERIFIED", "PACKAGED", "BLOCKED"]},
    "approval": {"type": "object", "required": ["status"]},
    "similarity": {"type": "object", "required": ["status"]}
  }
}

